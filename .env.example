# Shared
NODE_ENV=development
HOMEMONITOR_HOST=localhost

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
SESSION_SECRET=change-me-before-deploy
BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_PASSWORD=change-me
AGENT_TOKEN=dev-agent-token
DATABASE_URL=postgres://homemonitor:homemonitor@localhost:5432/homemonitor
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=https://storage.yandexcloud.net
S3_BUCKET=homemonitor-telemetry-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Web
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:4000

# Pi agent / simulator
HOMEMONITOR_CLOUD_WS=ws://127.0.0.1:4000/agent
HOMEMONITOR_AGENT_ID=pi-entrance-01
HOMEMONITOR_HOME_ID=home-main
HOMEMONITOR_AGENT_TOKEN=dev-agent-token
HOMEMONITOR_DATA_DIR=./data/pi-agent
HOMEMONITOR_ADAPTER=simulator
