{
  "name": "home-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm --workspace @homemonitor/api run dev",
    "dev:web": "npm --workspace @homemonitor/web run dev",
    "dev:agent": "npm --workspace @homemonitor/pi-agent run dev",
    "simulator": "npm --workspace @homemonitor/simulator run dev",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run typecheck",
    "format": "prettier --write .",
    "db:migrate": "npm --workspace @homemonitor/db run migrate",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up --build"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "next": {
      "postcss": "^8.5.10"
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
